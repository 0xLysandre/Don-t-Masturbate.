{
  "manifest_version": 3,
  "name": "Accountability Blocker",
  "version": "0.1.0",
  "description": "Blocks a personal list of sites and search terms for a locked-in period, with a daily check-in streak. All data stays on your machine.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Accountability Blocker"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.uk/*",
        "*://*.google.ca/*",
        "*://*.google.com.au/*",
        "*://*.google.de/*",
        "*://*.google.fr/*",
        "*://*.google.es/*",
        "*://*.google.it/*",
        "*://*.google.nl/*",
        "*://*.google.pl/*",
        "*://*.google.co.in/*",
        "*://*.google.com.br/*",
        "*://*.bing.com/*",
        "*://*.duckduckgo.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["shared/matcher.js", "content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
